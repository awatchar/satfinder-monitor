{
  "name": "satfinder-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API tooling and Apps Script source for SatFinder Worldmonitor",
  "scripts": {
    "google:auth": "node scripts/google-auth.mjs",
    "sheet:info": "node scripts/google-sheets.mjs info",
    "sheet:read": "node scripts/google-sheets.mjs read",
    "sheet:write": "node scripts/google-sheets.mjs write",
    "sheet:clear": "node scripts/google-sheets.mjs clear",
    "tinygs:sync": "node scripts/tinygs-sync.mjs",
